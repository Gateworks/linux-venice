#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/leds/common.h>
#include <dt-bindings/phy/phy-imx8-pcie.h>

/ {
	aliases {
		fsa1 = &i2c3;
	};

	connector {
		compatible = "gpio-usb-b-connector", "usb-b-connector";
		id-gpios = <&gpio3 21 GPIO_ACTIVE_HIGH>;
		label = "Type-C";
		pinctrl-0 = <&pinctrl_usbcon1>;
		pinctrl-names = "default";
		type = "micro";

		port {
			usb_dr_connector: endpoint {
				remote-endpoint = <&usb3_dwc>;
			};
		};
	};

	led-controller {
		compatible = "gpio-leds";
		pinctrl-0 = <&pinctrl_gpio_leds>;
		pinctrl-names = "default";

		led-0 {
			color = <LED_COLOR_ID_GREEN>;
			default-state = "on";
			function = LED_FUNCTION_STATUS;
			gpios = <&gpio4 1 GPIO_ACTIVE_HIGH>;
			linux,default-trigger = "heartbeat";
		};

		led-1 {
			color = <LED_COLOR_ID_RED>;
			default-state = "off";
			function = LED_FUNCTION_STATUS;
			gpios = <&gpio4 5 GPIO_ACTIVE_HIGH>;
		};
	};

	pcie0_refclk: clock-pcie0 {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <100000000>;
	};

	pps {
		compatible = "pps-gpio";
		gpios = <&gpio4 3 GPIO_ACTIVE_HIGH>;
		pinctrl-0 = <&pinctrl_pps>;
		pinctrl-names = "default";
	};
};

&ecspi2 {
	cs-gpios = <&gpio1 10 GPIO_ACTIVE_LOW>,	/* CS0 onboard TPM */
		   <&gpio4 26 GPIO_ACTIVE_LOW>; /* CS1 off-board J30 FSA1 */
	pinctrl-0 = <&pinctrl_spi2>;
	pinctrl-names = "default";
	status = "okay";

	tpm@0 {
		compatible = "atmel,attpm20p", "tcg,tpm_tis-spi";
		reg = <0x0>;
		spi-max-frequency = <10000000>;
	};
};

&flexcan1 {
	pinctrl-0 = <&pinctrl_can1>;
	pinctrl-names = "default";
	status = "okay";
};

&flexcan2 {
	pinctrl-0 = <&pinctrl_can2>;
	pinctrl-names = "default";
	status = "okay";
};

&gpio1 {
	gpio-line-names = "", "", "", "",
		"fsa1_gpio3", "", "", "",
		"", "", "", "",
		"", "fsa1_gpio1", "", "",
		"", "", "", "",
		"", "", "", "",
		"", "", "", "",
		"", "", "", "";
};

&gpio4 {
	gpio-line-names = "", "", "", "",
		"fsa1_gpio4", "", "", "",
		"dio1", "", "", "dio0",
		"fsa1_present#", "", "fsa1_card_pen", "",
		"", "", "", "",
		"", "", "rs485_en", "rs485_term",
		"fsa1_gpio2", "", "", "rs485_half",
		"", "", "", "";
};

&i2c2 {
	accelerometer@19 {
		compatible = "st,lis2de12";
		reg = <0x19>;
		interrupt-parent = <&gpio4>;
		interrupts = <21 IRQ_TYPE_LEVEL_LOW>;
		pinctrl-0 = <&pinctrl_accel>;
		pinctrl-names = "default";
		st,drdy-int-pin = <1>;
	};

	magnetometer@1e {
		compatible = "st,lis2mdl";
		reg = <0x1e>;
		interrupt-parent = <&gpio4>;
		interrupts = <28 IRQ_TYPE_LEVEL_LOW>;
		pinctrl-0 = <&pinctrl_mag>;
		pinctrl-names = "default";
	};
};

&i2c3 {
	gpio@20 {
		compatible = "nxp,pca9555";
		reg = <0x20>;
		#interrupt-cells = <2>;
		interrupt-controller;
		interrupt-parent = <&gpio4>;
		interrupts = <4 IRQ_TYPE_EDGE_FALLING>;
		#gpio-cells = <2>;
		gpio-controller;
	};

	eeprom@54 {
		compatible = "atmel,24c02";
		reg = <0x54>;
		pagesize = <16>;
	};

	eeprom@55 {
		compatible = "atmel,24c02";
		reg = <0x55>;
		pagesize = <16>;
	};
};

&iomuxc {
	pinctrl-0 = <&pinctrl_hog>;
	pinctrl-names = "default";

	pinctrl_accel: accelgrp {
		fsl,pins = <
			MX8MP_IOMUXC_SAI2_RXFS__GPIO4_IO21	0x150	/* IRQ# */
		>;
	};

	pinctrl_can1: can1grp {
		fsl,pins = <
			MX8MP_IOMUXC_SPDIF_TX__CAN1_TX		0x154
			MX8MP_IOMUXC_SPDIF_RX__CAN1_RX		0x154
		>;
	};

	pinctrl_can2: can2grp {
		fsl,pins = <
			MX8MP_IOMUXC_SAI5_RXD3__CAN2_TX		0x154
			MX8MP_IOMUXC_SAI5_MCLK__CAN2_RX		0x154
		>;
	};

	pinctrl_gpio_leds: gpioledgrp {
		fsl,pins = <
			MX8MP_IOMUXC_SAI1_RXC__GPIO4_IO01	0x6	/* LEDG */
			MX8MP_IOMUXC_SAI1_RXD3__GPIO4_IO05	0x6	/* LEDR */
		>;
	};

	pinctrl_hog: hoggrp {
		fsl,pins = <
			MX8MP_IOMUXC_SAI1_RXD6__GPIO4_IO08	0x146	/* DIO1 */
			MX8MP_IOMUXC_SAI1_TXC__GPIO4_IO11	0x146	/* DIO0 */
			MX8MP_IOMUXC_SAI2_MCLK__GPIO4_IO27	0x106	/* RS485_HALF */
			MX8MP_IOMUXC_SAI2_RXC__GPIO4_IO22	0x106	/* RS485_EN */
			MX8MP_IOMUXC_SAI2_RXD0__GPIO4_IO23	0x106	/* RS485_TERM */
			MX8MP_IOMUXC_SAI1_TXD2__GPIO4_IO14	0x1d0	/* FSA1_PEN */
			MX8MP_IOMUXC_SAI1_TXD0__GPIO4_IO12	0x1d0	/* FSA1_PRES# */
		>;
	};

	pinctrl_mag: maggrp {
		fsl,pins = <
			MX8MP_IOMUXC_SAI3_RXFS__GPIO4_IO28	0x140	/* IRQ# */
		>;
	};

	pinctrl_pcie0: pcie0grp {
		fsl,pins = <
			MX8MP_IOMUXC_SAI3_RXC__GPIO4_IO29	0x106	/* PERST# */
		>;
	};

	pinctrl_pps: ppsgrp {
		fsl,pins = <
			MX8MP_IOMUXC_SAI1_RXD1__GPIO4_IO03	0x146
		>;
	};

	pinctrl_spi2: spi2grp {
		fsl,pins = <
			MX8MP_IOMUXC_ECSPI2_SCLK__ECSPI2_SCLK	0xd0
			MX8MP_IOMUXC_ECSPI2_MOSI__ECSPI2_MOSI	0xd0
			MX8MP_IOMUXC_ECSPI2_MISO__ECSPI2_MISO	0xd0
			MX8MP_IOMUXC_GPIO1_IO10__GPIO1_IO10	0x140	/* TPM_CS */
			MX8MP_IOMUXC_SAI2_TXD0__GPIO4_IO26	0x140	/* FSA1_CS */
		>;
	};

	pinctrl_uart1: uart1grp {
		fsl,pins = <
			MX8MP_IOMUXC_UART1_RXD__UART1_DCE_RX	0x140
			MX8MP_IOMUXC_UART1_TXD__UART1_DCE_TX	0x140
		>;
	};

	pinctrl_uart4: uart4grp {
		fsl,pins = <
			MX8MP_IOMUXC_UART4_RXD__UART4_DCE_RX	0x140
			MX8MP_IOMUXC_UART4_TXD__UART4_DCE_TX	0x140
		>;
	};

	pinctrl_usb1: usb1grp {
		fsl,pins = <
			MX8MP_IOMUXC_SAI1_RXC__GPIO4_IO01	0x140 /* USB1_FLT# */
		>;
	};

	pinctrl_usbcon1: usbcon1grp {
		fsl,pins = <
			MX8MP_IOMUXC_SAI5_RXD0__GPIO3_IO21	0x140 /* USB1_ID */
		>;
	};

	pinctrl_usdhc1: usdhc1grp {
		fsl,pins = <
			MX8MP_IOMUXC_SD1_CLK__USDHC1_CLK	0x190
			MX8MP_IOMUXC_SD1_CMD__USDHC1_CMD	0x1d0
			MX8MP_IOMUXC_SD1_DATA0__USDHC1_DATA0	0x1d0
			MX8MP_IOMUXC_SD1_DATA1__USDHC1_DATA1	0x1d0
			MX8MP_IOMUXC_SD1_DATA2__USDHC1_DATA2	0x1d0
			MX8MP_IOMUXC_SD1_DATA3__USDHC1_DATA3	0x1d0
		>;
	};

	pinctrl_usdhc1_100mhz: usdhc1-100mhzgrp {
		fsl,pins = <
			MX8MP_IOMUXC_SD1_CLK__USDHC1_CLK	0x194
			MX8MP_IOMUXC_SD1_CMD__USDHC1_CMD	0x1d4
			MX8MP_IOMUXC_SD1_DATA0__USDHC1_DATA0	0x1d4
			MX8MP_IOMUXC_SD1_DATA1__USDHC1_DATA1	0x1d4
			MX8MP_IOMUXC_SD1_DATA2__USDHC1_DATA2	0x1d4
			MX8MP_IOMUXC_SD1_DATA3__USDHC1_DATA3	0x1d4
		>;
	};

	pinctrl_usdhc1_200mhz: usdhc1-200mhzgrp {
		fsl,pins = <
			MX8MP_IOMUXC_SD1_CLK__USDHC1_CLK	0x196
			MX8MP_IOMUXC_SD1_CMD__USDHC1_CMD	0x1d6
			MX8MP_IOMUXC_SD1_DATA0__USDHC1_DATA0	0x1d6
			MX8MP_IOMUXC_SD1_DATA1__USDHC1_DATA1	0x1d6
			MX8MP_IOMUXC_SD1_DATA2__USDHC1_DATA2	0x1d6
			MX8MP_IOMUXC_SD1_DATA3__USDHC1_DATA3	0x1d6
		>;
	};
};

&pcie {
	pinctrl-0 = <&pinctrl_pcie0>;
	pinctrl-names = "default";
	reset-gpio = <&gpio4 29 GPIO_ACTIVE_LOW>;
	status = "okay";
};

&pcie_phy {
	clocks = <&pcie0_refclk>;
	clock-names = "ref";
	fsl,clkreq-unsupported;
	fsl,refclk-pad-mode = <IMX8_PCIE_REFCLK_PAD_INPUT>;
	status = "okay";
};

/* GPS */
&uart1 {
	pinctrl-0 = <&pinctrl_uart1>;
	pinctrl-names = "default";
	status = "okay";
};

/* RS232 */
&uart4 {
	pinctrl-0 = <&pinctrl_uart4>;
	pinctrl-names = "default";
	status = "okay";
};

&usb3_0 {
	pinctrl-0 = <&pinctrl_usb1>;
	pinctrl-names = "default";
	fsl,over-current-active-low;
	status = "okay";
};

&usb3_1 {
	fsl,disable-port-power-control;
	fsl,permanently-attached;
	status = "okay";
};

&usb3_phy0 {
	status = "okay";
};

&usb3_phy1 {
	status = "okay";
};

&usb_dwc3_0 {
	/* dual role is implemented but not a full featured OTG */
	adp-disable;
	dr_mode = "otg";
	hnp-disable;
	role-switch-default-mode = "peripheral";
	srp-disable;
	usb-role-switch;
	status = "okay";

	port {
		usb3_dwc: endpoint {
			remote-endpoint = <&usb_dr_connector>;
		};
	};
};

&usb_dwc3_1 {
	dr_mode = "host";
	status = "okay";
};

/* SDIO 1.8V */
&usdhc1 {
	bus-width = <4>;
	non-removable;
	pinctrl-0 = <&pinctrl_usdhc1>;
	pinctrl-1 = <&pinctrl_usdhc1_100mhz>;
	pinctrl-2 = <&pinctrl_usdhc1_200mhz>;
	pinctrl-names = "default", "state_100mhz", "state_200mhz";
	status = "okay";
};
